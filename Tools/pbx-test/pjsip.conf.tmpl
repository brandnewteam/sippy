; Sippy integration-test PBX. @HOST_IP@ is substituted at container start:
; the container is NATed, so SDP and Contact must advertise the host address
; for the port mappings to carry media back to the client.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=@HOST_IP@
external_signaling_address=@HOST_IP@

[endpoint-defaults](!)
type=endpoint
context=testing
disallow=all
allow=alaw,ulaw,g722
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[6001](endpoint-defaults)
auth=auth6001
aors=6001

[auth6001]
type=auth
auth_type=userpass
username=6001
password=test6001

[6001]
type=aor
max_contacts=5
remove_existing=yes

[6002](endpoint-defaults)
auth=auth6002
aors=6002

[auth6002]
type=auth
auth_type=userpass
username=6002
password=test6002

[6002]
type=aor
max_contacts=5
remove_existing=yes
