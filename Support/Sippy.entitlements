<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime entitlements for notarization. The microphone is
	     the only restricted capability a softphone needs; Contacts access is
	     governed by the usage description, not an entitlement (no sandbox). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
